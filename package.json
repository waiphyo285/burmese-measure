{
  "name": "burmese-measure",
  "version": "2.0.0",
  "description": "A comprehensive conversion package for Burmese measurement units and Metric system",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "burmese-measure": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "docs": "typedoc --out docs lib/index.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waiphyo285/burmese-measure.git"
  },
  "keywords": [
    "burmese",
    "myanmar",
    "measure",
    "conversion",
    "metric",
    "units",
    "mass",
    "length",
    "volume",
    "money"
  ],
  "author": "Wai Phyo",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^7.2.0",
    "typedoc": "^0.25.13",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
